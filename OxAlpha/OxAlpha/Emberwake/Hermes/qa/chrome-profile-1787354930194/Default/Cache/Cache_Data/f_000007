    if (state === 'play') {
      if (keys.KeyW || keys.ArrowUp) inp.mz -= 1;   // W = up-screen = away from camera
      if (keys.KeyS || keys.ArrowDown) inp.mz += 1;
      if (keys.KeyA || keys.ArrowLeft) inp.mx -= 1;
      if (keys.KeyD || keys.ArrowRight) inp.mx += 1;
      if (keys.ShiftLeft || keys.ShiftRight) inp.sprint = 1;
