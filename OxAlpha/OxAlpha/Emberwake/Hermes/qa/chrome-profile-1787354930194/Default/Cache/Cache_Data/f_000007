      setTimeout(function () { window.dispatchEvent(new KeyboardEvent('keyup', { code: code })); }, 90);
    },
    hold: function (code, ms) {
      window.dispatchEvent(new KeyboardEvent('keydown', { code: code }));
      setTimeout(function () { window.dispatchEvent(new KeyboardEvent('keyup', { code: code })); }, ms || 1000);
    },
    get autopilotResult() { return window.__EW_AUTOPILOT_RESULT || null; }
  };

  // boot
  if (SKIP_TITLE) {
    // build immediately and drop into play for automated runs
    sim = Sim.createSim({ seed: 'EPIC-1' });
    buildWorld(sim.world);
    worldBuilt = true;
    audio = Audio.create(); applyVolumes();
    if (!QA) audio.start(); else { try { audio.start(); } catch (e) { } }
    audio.setRegion('ashfall');
    state = 'play';
    UI.hideScreens();
    UI.showHUD(true);
    if (AUTOPILOT) console.log('[AUTOPILOT] run started');
  } else {
    UI.showScreen('title');
  }
  tick();
})();
