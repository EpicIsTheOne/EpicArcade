  // ---------- autopilot (visual run driver, mirrors the Node-tested strategy) ----------
  function autopilotInput(dt) {
    var k = sim.keeper;
    var inp = { mx: 0, mz: 0, level: 2, bank: 0, sprint: 0, flare: 0, interact: 0 };
    if (state === 'shrine') {
      sim.healBeetles();
      if (sim.shards >= 12 && sim.beetles.some(function (b) { return !b.alive; })) sim.healBeetles();
      if (sim.shards >= 6 && k.upgrades.wick < 3) sim.buyUpgrade('wick');
      else if (sim.shards >= 5 && k.upgrades.aura < 3) sim.buyUpgrade('aura');
      else if (sim.shards >= 5 && k.upgrades.emberH < 3) sim.buyUpgrade('emberH');
      inp.interact = 2;
      return inp;
    }
    var wr = sim.helpers.warmRadius();
    var near = 1e9, swarm = 0;
    sim.hollows.forEach(function (h) {
      var d = Math.hypot(h.x - k.x, h.z - k.z);
      near = Math.min(near, d);
      if (d < wr * 1.15) swarm++;
    });
    var wardenNear = false;
    sim.wardens.forEach(function (wd) {
      var d = Math.hypot(wd.x - k.x, wd.z - k.z);
      near = Math.min(near, d * 0.8);
      if (d < 4.2) wardenNear = true;
    });

    // boss plan
    var BW = sim.wraith;
    if (BW && BW.alive && k.x > 355) {
      var bfx = 372 - k.x, bfz = 10 - k.z;
      var bfl = Math.hypot(bfx, bfz);
      if (bfl > 1.5 && k.fuel < 70) { inp.mx = bfx / bfl; inp.mz = bfz / bfl; }
      if (BW.state === 'telegraph' || BW.state === 'dive') {
        var ddx = k.x - BW.teleX, ddz = k.z - BW.teleZ;
        var dl = Math.hypot(ddx, ddz) || 1;
        if (dl < 4.0) { inp.mx = -ddz / dl; inp.mz = ddx / dl; }
      }
      var bdw = Math.hypot(BW.x - k.x, BW.z - k.z);
      var bvuln = BW.state === 'dive' || BW.state === 'telegraph';
      var bnear = 0;
      sim.hollows.forEach(function (h) { if (Math.hypot(h.x - k.x, h.z - k.z) < 6) bnear++; });
      inp.flare = (k.flareRecover <= 0 && k.fuel >= 18 &&
        ((bdw < 11 && (bvuln || bdw < 8.5)) || bnear >= 2)) ? 1 : 0;
      return inp;
    }

    if (k.flareRecover <= 0 && k.fuel > 34 && (swarm >= 2 || near < 3.2 || wardenNear)) inp.flare = 1;
    else if (near < 5.5 && swarm === 0 && sim.wardens.length === 0) inp.level = 0;
    else if (k.fuel > 55 && swarm === 0 && near > wr) inp.level = 2;
    else inp.level = k.fuel < 25 ? 0 : 1;
    if (swarm === 0 && near > 12 && k.fuel < 12) inp.bank = 1;

    // navigation target: next shrine / gate
    var tgt = null;
    for (var i = 0; i < sim.world.shrines.length; i++) if (!sim.world.shrines[i].lit) { tgt = sim.world.shrines[i]; break; }
    if (!tgt) tgt = { x: 396, z: 0 };
    var dx = tgt.x - k.x, dz = tgt.z - k.z, dl2 = Math.hypot(dx, dz);

    if (dl2 < 3.6 && sim.helpers.canInteract()) { inp.interact = 1; return inp; }

    if (k.fuel < 42) {
      var food = null, fc = 1e9;
      sim.world.props.forEach(function (p) {
        if ((p.kind !== 'moss' && p.kind !== 'cache') || p.dead) return;
        var pd = Math.hypot(p.x - k.x, p.z - k.z);
        var cost = pd + (p.kind === 'cache' ? -6 : 0);
        if (pd < 26 && cost < fc) { fc = cost; food = p; }
      });
      if (food) { dx = food.x - k.x; dz = food.z - k.z; dl2 = Math.hypot(dx, dz); }
    }
    if (dl2 > 0.5) { inp.mx = dx / dl2; inp.mz = dz / dl2; }
    inp.sprint = dl2 > 18 && k.fuel > 45 ? 1 : 0;
    return inp;
  }

