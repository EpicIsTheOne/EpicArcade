/* Emberwake — main.js
 * Engine glue: three.js scene, procedural terrain bake, entity sync, camera/input,
 * event choreography (particles/audio/UI), adaptive music director, quality tiers,
 * autopilot, QA debug hooks. Global `window.EWGame`.
 */
(function () {
  'use strict';

  var Sim = window.EWSim, Ent = window.EWEnt, Audio = window.EmberAudio, UI = window.EWUI;

  // ---------- settings / persistence ----------
  var SET_KEY = 'ew_settings';
  var settings = {
    master: 0.8, music: 0.7, sfx: 0.9,
    quality: 'ULTRA', shake: true, reduceFlash: false, colorSafe: false
  };
  try {
    var saved = JSON.parse(localStorage.getItem(SET_KEY) || 'null');
    if (saved) Object.keys(settings).forEach(function (k) { if (saved[k] !== undefined) settings[k] = saved[k]; });
  } catch (e) { /* ignore */ }
  function saveSettings() {
    try { localStorage.setItem(SET_KEY, JSON.stringify(settings)); } catch (e) { /* ignore */ }
  }

  var QA = /[\?&]qa=1/.test(location.search);
  var AUTOPILOT = /[\?&]autopilot=1/.test(location.search);
  var SKIP_TITLE = QA || AUTOPILOT;

  // ---------- renderer / scene ----------
  var canvas = document.getElementById('game-canvas');
  var renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: !QA, powerPreference: 'high-performance' });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, QA ? 1 : 2));
  renderer.shadowMap.enabled = false; // stylized blob shadows instead — cheaper and reads better at night

  var scene = new THREE.Scene();
  var camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 900);

  var hemi = new THREE.HemisphereLight(0x2b3a5e, 0x1a1420, 0.75);
  scene.add(hemi);
  var moon = new THREE.DirectionalLight(0x8fa8d8, 0.22);
  moon.position.set(-120, 180, -80);
  scene.add(moon);

  // lantern light — the hero light of the game
  var lanternLight = new THREE.PointLight(0xffa04c, 1.6, 40, 2);
  scene.add(lanternLight);
  var lanternGlow = Ent.makeGlow(0xffa04c, 4.2, 0.85);
  scene.add(lanternGlow);

  // aurora ribbons
  var auroraGroup = new THREE.Group();
  scene.add(auroraGroup);
  for (var ai = 0; ai < 3; ai++) {
    var aGeo = new THREE.PlaneGeometry(700, 60 + ai * 24, 48, 1);
    var aMat = new THREE.ShaderMaterial({
      transparent: true, depthWrite: false, side: THREE.DoubleSide,
      uniforms: { uTime: { value: 0 }, uHue: { value: ai * 0.35 } },
      vertexShader:
        'varying vec2 vUv; uniform float uTime;' +
        'void main(){ vUv=uv; vec3 p=position;' +
        'p.z += sin(uv.x*7.0+uTime*0.25)*14.0 + sin(uv.x*13.0-uTime*0.17)*7.0;' +
        'gl_Position = projectionMatrix*modelViewMatrix*vec4(p,1.0);}',
      fragmentShader:
        'varying vec2 vUv; uniform float uTime; uniform float uHue;' +
        'float band(vec2 uv,float c,float w){return smoothstep(c-w,c,uv.y)-smoothstep(c,c+w,uv.y);}' +
        'void main(){' +
        ' float b1=band(vUv,0.45+sin(vUv.x*5.0+uTime*0.3)*0.12,0.16);' +
        ' float b2=band(vUv,0.62+cos(vUv.x*4.0-uTime*0.22)*0.10,0.20);' +
        ' float a=(b1*0.55+b2*0.35)*(0.32+0.20*sin(uTime*0.4+vUv.x*9.0));' +
        ' vec3 col=mix(vec3(0.30,0.85,0.65),vec3(0.45,0.50,0.95),0.5+0.5*sin(vUv.x*3.0+uHue));' +
        ' gl_FragColor=vec4(col,a);} '
    });
    var ribbon = new THREE.Mesh(aGeo, aMat);
    ribbon.position.set(0, 90 + ai * 26, -160 + ai * 30);
    ribbon.frustumCulled = false;
    auroraGroup.add(ribbon);
  }

  // fog per region (set on region change)
  scene.fog = new THREE.FogExp2(0x141a2a, 0.0075);

  // stars
  (function makeStars() {
    var n = 700;
    var pos = new Float32Array(n * 3);
    for (var i = 0; i < n; i++) {
      var th = Math.random() * Math.PI * 2, ph = Math.random() * Math.PI * 0.42;
      pos[i * 3] = Math.cos(th) * Math.sin(ph + 0.15) * 800;
      pos[i * 3 + 1] = Math.cos(ph) * 500 + 60;
      pos[i * 3 + 2] = Math.sin(th) * Math.sin(ph + 0.15) * 800;
    }
    var g = new THREE.BufferGeometry();
    g.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    var m = new THREE.PointsMaterial({ color: 0xbfd0ff, size: 1.6, sizeAttenuation: false, transparent: true, opacity: 0.8 });
    var stars = new THREE.Points(g, m);
    stars.frustumCulled = false;
    scene.add(stars);
  })();

  // ---------- world baking ----------
  var sim = null;
  var keeperObj = null;
  var beetleObjs = [];
  var hollowObjs = [];
  var wispObjs = [];
  var wardenObjs = [];
  var wraithObj = null;
  var shrineObjs = [];
  var gateObj = null;
  var particles = null;
  var motes = null;
  var pondMeshes = [];
  var fissureGlows = [];

  function buildWorld(world) {
    // ---- ground: one big plane, vertex-displaced, road-blended colors ----
    var SEG_X = QA ? 110 : 190, SEG_Z = QA ? 70 : 120;
    var geo = new THREE.PlaneGeometry(880, 480, SEG_X, SEG_Z);
    geo.rotateX(-Math.PI / 2);
    var posA = geo.attributes.position;
    var colors = new Float32Array(posA.count * 3);
    var tmpC = new THREE.Color();
    for (var i = 0; i < posA.count; i++) {
      var vx = posA.getX(i), vz = posA.getZ(i);
      var h = world.height(vx, vz);
      posA.setY(i, h);
      // base grass color by region blend
      var rg = world.regionAtX(vx);
      var n = 0.82 + 0.18 * Math.sin(vx * 0.31 + vz * 0.53) * Math.cos(vz * 0.21);
      var nr = world.roadNearest(vx, vz);
      var onRoad = nr.dist < world.ROAD_HALF + 1.2;
      if (onRoad) {
        tmpC.setHex(rg.dirt).multiplyScalar(1.06);
      } else {
        tmpC.setHex((Math.sin(vx * 0.08 + vz * 0.11) > 0) ? rg.grassA : rg.grassB).multiplyScalar(n);
      }
      if (h > 26) tmpC.lerp(new THREE.Color(rg.rock), Math.min(1, (h - 26) / 14));
      colors[i * 3] = tmpC.r; colors[i * 3 + 1] = tmpC.g; colors[i * 3 + 2] = tmpC.b;
    }
    geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
    geo.computeVertexNormals();
    var groundMat = new THREE.MeshLambertMaterial({ vertexColors: true });
    var ground = new THREE.Mesh(geo, groundMat);
    scene.add(ground);

    // ---- frozen ponds ----
    world.ponds.forEach(function (p) {
      var pg = new THREE.CircleGeometry(p.r, 26);
      pg.rotateX(-Math.PI / 2);
      var pm = new THREE.Mesh(pg, new THREE.MeshPhongMaterial({
        color: 0x7ea6c8, specular: 0xcfe8ff, shininess: 90,
        transparent: true, opacity: 0.82
      }));
      pm.position.set(p.x, p.y + 0.28, p.z);
      pm.rotation.z = Math.random() * Math.PI;
      scene.add(pm);
      pondMeshes.push(pm);
    });

    // ---- lava fissures ----
    world.fissures.forEach(function (f) {
      var fg = new THREE.Mesh(
        new THREE.CircleGeometry(1, 24),
        new THREE.MeshBasicMaterial({ color: 0xff5a1e })
      );
      fg.scale.set(f.rx, f.rz, 1);
      fg.rotation.x = -Math.PI / 2;
      fg.rotation.z = f.rot;
      fg.position.set(f.x, f.y + 0.22, f.z);
      scene.add(fg);
      var glow = Ent.makeGlow(0xff6a24, f.rx * 1.7, 0.5);
      glow.position.set(f.x, f.y + 0.8, f.z);
      scene.add(glow);
      fissureGlows.push({ mesh: fg, glow: glow, seed: Math.random() * 10 });
    });

    // ---- props (trees/rocks/spires/moss/shards/caches) ----
    world.props.forEach(function (p) {
      var obj = null;
      if (p.kind.indexOf('tree_') === 0) obj = Ent.makeTree(p.kind.slice(5), p.v);
      else if (p.kind === 'rock') obj = Ent.makeRock(p.v);
      else if (p.kind === 'spire') obj = Ent.makeSpire();
      else if (p.kind === 'moss') obj = Ent.makeMossTuft();
      else if (p.kind === 'shard') obj = Ent.makeShardCrystal();
      else if (p.kind === 'cache') {
        obj = new THREE.Group();
        var logs = new THREE.Mesh(new THREE.CylinderGeometry(0.34, 0.34, 1.1, 6),
          Ent.lam(0x5a4426));
        logs.rotation.z = Math.PI / 2;
        logs.position.y = 0.36;
        var logs2 = logs.clone(); logs2.rotation.y = Math.PI / 2.6; logs2.position.y = 0.52;
        obj.add(logs); obj.add(logs2);
        var cg = Ent.makeGlow(0xffb060, 1.0, 0.4);
        cg.position.y = 0.6;
        obj.add(cg);
      }
      if (!obj) return;
      obj.position.set(p.x, p.y, p.z);
      obj.rotation.y = p.rot;
      obj.scale.multiplyScalar(p.s);
      scene.add(obj);
      p.obj = obj;
    });

    // ---- shrines ----
    world.shrines.forEach(function (s) {
      var o = Ent.makeShrine();
      o.position.set(s.x, world.height(s.x, s.z), s.z);
      scene.add(o);
      shrineObjs.push(o);
      s.obj = o;
    });

    // ---- Dawn Gate ----
    gateObj = Ent.makeDawnGate();
    gateObj.position.set(world.dawnGate.x, world.height(world.dawnGate.x, world.dawnGate.z), world.dawnGate.z);
    scene.add(gateObj);

    // ---- keeper ----
    keeperObj = new THREE.Group();
    var cloak = new THREE.Mesh(new THREE.ConeGeometry(0.5, 1.7, 7), Ent.lam(0x37405c, { flat: true }));
    cloak.position.y = 0.85;
    keeperObj.add(cloak);
    var head = new THREE.Mesh(new THREE.SphereGeometry(0.23, 8, 6), Ent.lam(0xd9b38c, { flat: true }));
    head.position.y = 1.78;
    keeperObj.add(head);
    var hood = new THREE.Mesh(new THREE.ConeGeometry(0.3, 0.5, 7), Ent.lam(0x2c3348, { flat: true }));
    hood.position.y = 1.92;
    keeperObj.add(hood);
    var staff = new THREE.Mesh(new THREE.CylinderGeometry(0.045, 0.06, 2.1, 5), Ent.lam(0x4a3826));
    staff.position.set(0.44, 1.05, 0.1);
    keeperObj.add(staff);
    var lantFrame = new THREE.Mesh(new THREE.BoxGeometry(0.22, 0.3, 0.22),
      new THREE.MeshLambertMaterial({ color: 0x2a2018, emissive: 0xff9c40, emissiveIntensity: 0.4 }));
    lantFrame.position.set(0.44, 1.95, 0.1);
    keeperObj.add(lantFrame);
    var lantGlow = Ent.makeGlow(0xffb454, 1.5, 0.95);
    lantGlow.position.set(0.44, 1.95, 0.1);
    keeperObj.add(lantGlow);
    keeperObj.userData.lantGlow = lantGlow;
    keeperObj.userData.lantFrame = lantFrame;
    var shadowBlob = new THREE.Mesh(new THREE.CircleGeometry(0.55, 14),
      new THREE.MeshBasicMaterial({ color: 0x000000, transparent: true, opacity: 0.35 }));
    shadowBlob.rotation.x = -Math.PI / 2;
    shadowBlob.position.y = 0.03;
    keeperObj.add(shadowBlob);
    scene.add(keeperObj);

    // ---- caravan ----
    beetleObjs = [];
    sim.beetles.forEach(function (b) {
      var o = Ent.makeBeetle(Ent.BEETLE_SHELLS[b.shell]);
      scene.add(o);
      beetleObjs.push(o);
    });

    // ---- particles & weather ----
    particles = new Ent.ParticlePool(scene, QA ? 220 : 650);
    motes = new Ent.MoteField(scene, QA ? 140 : 420, 240, 0xcfd8e8, 0.35, 1.1);
  }

  // ---------- camera ----------
  var camYaw = 0, camPitch = 0.46, camDist = 15;
  var camPos = new THREE.Vector3(), camTarget = new THREE.Vector3();
  var shakeT = 0, shakeMag = 0;

  document.addEventListener('mousemove', function (ev) {
    if (state !== 'play' && state !== 'shrine') return;
    if (document.pointerLockElement === canvas) {
      camYaw -= ev.movementX * 0.0032;   // mouse right → view rotates right
      camPitch += ev.movementY * 0.0026; // mouse down → look down
      camPitch = Math.max(0.12, Math.min(1.15, camPitch));
    }
  });
  canvas.addEventListener('wheel', function (ev) {
    camDist = Math.max(8, Math.min(26, camDist + ev.deltaY * 0.012));
    ev.preventDefault();
  }, { passive: false });
  canvas.addEventListener('click', function () {
    if ((state === 'play' || state === 'shrine') && document.pointerLockElement !== canvas && !AUTOPILOT) {
      canvas.requestPointerLock();
    }
  });
  document.addEventListener('contextmenu', function (ev) { ev.preventDefault(); });

  // ---------- input ----------
  var keys = {};
  var flareQueued = false, interactQueued = false;
  window.addEventListener('keydown', function (ev) {
    if (ev.repeat) return;
    keys[ev.code] = true;
    if (ev.code === 'Space') { flareQueued = true; ev.preventDefault(); }
    if (ev.code === 'KeyE') interactQueued = true;
    if (ev.code === 'KeyF') toggleBank();
    if (ev.code === 'Digit1') setLevel(0);
    if (ev.code === 'Digit2') setLevel(1);
    if (ev.code === 'Digit3') setLevel(2);
    if (ev.code === 'KeyP' || ev.code === 'Escape') togglePause();
    if (ev.code === 'Enter' && state === 'title') startRun();
  });
  window.addEventListener('keyup', function (ev) { keys[ev.code] = false; });

  function setLevel(l) { manualLevel = l; if (audio) audio.sfx.levelSet(); }
  function toggleBank() {
    banked = !banked;
    if (audio) { banked ? audio.sfx.bankOn() : audio.sfx.bankOff(); }
    if (sim) UI.toast(banked ? 'Flame banked — walk soft' : 'Flame raised', banked ? 'quiet' : '');
  }
  var manualLevel = 1, banked = false;

  // ---------- game flow ----------
  var state = 'title'; // title | howto | play | shrine | pause | elegy | victory
  var audio = null;
  var lastRegionKey = '';
  var pausedFrom = 'play';

  function startRun() {
    if (sim) disposeSim();
    sim = Sim.createSim({ seed: 'EPIC-1' });
    if (!worldBuilt) { buildWorld(sim.world); worldBuilt = true; }
    else resetDynamicProps();

    UI.hideScreens();
    UI.showHUD(true);
    UI.setObjective('Follow the pilgrim road east. Relight the wayshrines.');

    if (!audio) { audio = Audio.create(); applyVolumes(); }
    audio.start();
    audio.setRegion('ashfall');
    lastRegionKey = 'ashfall';

    manualLevel = 1; banked = false;
    state = 'play';
    if (!AUTOPILOT) canvas.requestPointerLock && canvas.requestPointerLock();
  }

  var worldBuilt = false;
  function resetDynamicProps() {
    // restore consumed props
    sim.world.props.forEach(function (p) {
      p.dead = false;
      if (p.obj) p.obj.visible = true;
    });
    sim.world.shrines.forEach(function (s, i) {
      s.lit = false;
      if (s.obj) { s.obj.userData.flame.visible = false; s.obj.userData.light.intensity = 0; }
    });
    // clear transient entities from the scene
    [hollowObjs, wispObjs, wardenObjs].forEach(function (list) {
      list.forEach(function (o) { scene.remove(o); });
      list.length = 0;
    });
    if (wraithObj) { scene.remove(wraithObj); wraithObj = null; }
  }

  function disposeSim() {
    resetDynamicProps.call({});
  }

  function togglePause() {
    if (state === 'play' || state === 'shrine') {
      pausedFrom = state;
      state = 'pause';
      UI.showScreen('pause');
      document.exitPointerLock && document.exitPointerLock();
    } else if (state === 'pause') {
      state = pausedFrom;
      UI.hideScreens();
    }
  }

  function toTitle() {
    state = 'title';
    UI.showHUD(false);
    UI.showScreen('title');
    UI.setBossBar(0, false);
    UI.wraithBanner(false);
    if (audio) audio.stop();
  }

  // ---------- entity pool management ----------
  function syncEntityPools() {
    // hollows
    while (hollowObjs.length < sim.hollows.length) {
      var ho = Ent.makeHollow();
      scene.add(ho);
      hollowObjs.push(ho);
    }
    while (wispObjs.length < sim.wisps.length) {
      var wo = Ent.makeWisp();
      scene.add(wo);
      wispObjs.push(wo);
    }
    while (wardenObjs.length < sim.wardens.length) {
      var wd = Ent.makeWarden();
      scene.add(wd);
      wardenObjs.push(wd);
    }
    if (sim.wraith && !sim.wraith.defeated) {
      if (!wraithObj) {
        wraithObj = Ent.makeWraith();
        scene.add(wraithObj);
      }
    } else if (wraithObj && (!sim.wraith || !sim.wraith.alive)) {
      scene.remove(wraithObj);
      wraithObj = null;
    }
  }

  // ---------- event choreography ----------
  function handleEvents(evs, dt) {
    evs.forEach(function (ev) {
      switch (ev.type) {
        case 'flare': {
          var k = sim.keeper;
          var ky = terrainYAt(k.x, k.z);
          particles.burst(k.x, ky + 1.2, k.z, 90, 9, 0.9, 0xffa040, -2);
          particles.burst(k.x, ky + 1.2, k.z, 40, 4, 1.3, 0xffdca0, -1);
          addShockwave(k.x, ky + 0.4, k.z, ev.data.r);
          shake(0.5);
          audio.sfx.flare();
          break;
        }
        case 'flareFail':
          audio.sfx.uiDeny();
          UI.toast('Not enough flame to flare', 'warn');
          break;
        case 'moss':
          audio.sfx.mossPickup();
          particles.burst(sim.keeper.x, sim.keeper.y0 + 0.5, sim.keeper.z, 10, 2, 0.5, 0x53e6b0, -2);
          break;
        case 'cache':
          audio.sfx.mossPickup();
          particles.burst(sim.keeper.x, sim.keeper.y0 ? sim.keeper.y0 : terrainYAt(sim.keeper.x, sim.keeper.z) + 0.5, sim.keeper.z, 18, 2.4, 0.7, 0xffb060, -2);
          UI.toast('Kindling cache — the ember swells', 'good');
          break;
        case 'shard':
          audio.sfx.shardPickup();
          break;
        case 'chirp':
          audio.sfx.beetleChirp(1000 + Math.random() * 400);
          break;
        case 'skitter':
          if (Math.random() < 0.6) audio.sfx.hollowSkitter();
          break;
        case 'beetleCold':
          break; // silent; HUD chip shows it
        case 'beetleHurt':
          audio.sfx.beetleHurt();
          flashDanger(settings.reduceFlash ? 0.12 : 0.3);
          shake(0.25);
          break;
        case 'shieldPop':
          audio.sfx.uiDeny();
          particles.burst(lastBeetlePos(ev.data.name).x, 0.8, lastBeetlePos(ev.data.name).z, 16, 3, 0.6, 0x86c8ff, -2);
          UI.toast(ev.data.name + '\'s shield shattered!', 'warn');
          break;
        case 'beetleDeath': {
          var bp = lastBeetlePos(ev.data.name);
          if (bp) particles.burst(bp.x, 0.8, bp.z, 42, 4, 1.2, 0xc46a3a, -3);
          audio.sfx.beetleDie();
          flashDanger(settings.reduceFlash ? 0.2 : 0.55);
          shake(0.6);
          UI.toast('✝ ' + ev.data.name + ' — ' + (ev.data.why || 'lost'), 'death');
          break;
        }
        case 'hollowDie':
          audio.sfx.hollowDie();
          break;
        case 'wispNear':
          audio.sfx.wispWhisper();
          UI.toast('Something out there is pretending to be warm…', 'warn');
          break;
        case 'lureStart':
          audio.sfx.wispWhisper();
          UI.toast(ev.data.name + ' is following a false light!', 'warn');
          break;
        case 'wispDie':
          audio.sfx.wispDie();
          break;
        case 'wardens':
          UI.toast('Frost Wardens stalk the Reach', 'warn');
          break;
        case 'wardenStep':
          if (Math.random() < 0.5) audio.sfx.wardenStep();
          break;
        case 'wardenDie':
          audio.sfx.hollowDie();
          UI.toast('Warden felled', 'good');
          break;
        case 'shrineLit':
          audio.sfx.shrineRelight();
          var sh = sim.world.shrines[ev.data.index];
          if (sh) particles.burst(sh.x, sh.obj.position.y + 2.4, sh.z, 60, 4, 1.4, 0xffc070, -1);
          UI.toast('Wayshrine relit  ·  ' + sim.shrinesLit + '/8', 'good');
          lastLitShrineIdx = ev.data.index;
          break;
        case 'shrineOpen':
          openShrine(lastLitShrineIdx || 0);
          break;
        case 'shrineClose':
          state = 'play';
          UI.hideScreens();
          if (!AUTOPILOT) canvas.requestPointerLock && canvas.requestPointerLock();
          break;
        case 'gateHint':
          UI.toast('The Dawn Gate waits beyond the Reach.', 'good');
          break;
        case 'gustStart':
          audio.sfx.windGust(0.2);
          UI.toast('A gust fans the flame!', 'warn');
          break;
        case 'wraithSpawn':
          audio.sfx.wraithRoar();
          UI.wraithBanner(true);
          setTimeout(function () { UI.wraithBanner(false); }, 3400);
          shake(0.8);
          break;
        case 'wraithTelegraph':
          audio.sfx.wraithRoar();
          if (wraithTeleMarker) updateTelegraphMarker(sim.wraith.teleX, sim.wraith.teleZ);
          break;
        case 'wraithDive':
          audio.sfx.windGust(0.3);
          break;
        case 'wraithSlam':
          audio.sfx.hollowSkitter();
          flashDanger(settings.reduceFlash ? 0.2 : 0.5);
          shake(0.7);
          UI.toast('The Wraith tore heat from you!', 'warn');
          break;
        case 'wraithSummon':
          audio.sfx.hollowSkitter();
          break;
        case 'wraithDie':
          audio.sfx.dawnStinger();
          shake(1.0);
          break;
        case 'upgrade':
          audio.sfx.upgrade();
          UI.toast('Upgrade woven into the wick', 'good');
          refreshShop(sim);
          break;
        case 'shopDeny':
          audio.sfx.uiDeny();
          break;
        case 'caravanHealed':
          audio.sfx.upgrade();
          refreshShop(sim);
          break;
        case 'beetleRevived':
          UI.toast(ev.data.name + ' crawls back to the light', 'good');
          refreshShop(sim);
          break;
        case 'gameover':
          endRun(false, ev.data.cause);
          break;
        case 'victory':
          endRun(true, null);
          break;
      }
    });
  }

  var shockwaves = [];
  function addShockwave(x, y, z, r) {
    var ring = new THREE.Mesh(
      new THREE.TorusGeometry(0.5, 0.09, 6, 40),
      new THREE.MeshBasicMaterial({ color: 0xffc070, transparent: true, opacity: 0.95 })
    );
    ring.rotation.x = -Math.PI / 2;
